# Azure app (client) id used for Microsoft sign-in. Must be approved by Mojang for Minecraft Services.
# Can also be set at runtime in Settings → Advanced.
MAIN_VITE_MS_CLIENT_ID=

# CurseForge Core API key from https://console.curseforge.com — enables CurseForge in Discover.
# Can also be set at runtime in Settings → Advanced.
MAIN_VITE_CURSEFORGE_API_KEY=

# Base URL of the update feed (electron-builder "generic" provider), used at package time.
ACE_UPDATE_URL=
